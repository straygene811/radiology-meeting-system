        "partitions": [
          {
            "name": "1_會議總表",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    來源 = Csv.Document(Web.Contents(\"http://localhost:3000/api/powerbi?table=meetings&format=csv\"),[Delimiter=\",\", Encoding=950, QuoteStyle=QuoteStyle.Csv]),",
                "    提升的標頭 = Table.PromoteHeaders(來源, [PromoteAllScalars=true]),",
                "    變更的類型 = Table.TransformColumnTypes(提升的標頭,{{\"應到人數\", Int64.Type}, {\"出席人數\", Int64.Type}, {\"值班休假人數\", Int64.Type}, {\"出席率百分比\", Int64.Type}, {\"已簽核人數\", Int64.Type}, {\"未簽核人數\", Int64.Type}, {\"簽核率百分比\", Int64.Type}})",
                "in",
                "    變更的類型"
              ]
            }
          }
        ]
